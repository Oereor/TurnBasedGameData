                    "$type": "RPG.GameCore.TargetFetchAdvPropEx"
                  },
                  "InteractID": {
                    "IsDynamic": false,
                    "FixedValue": {
                      "Value": 1100
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "TaskList": [
        {
          "$type": "RPG.GameCore.LoopWaitEntityServerEvent"
        }
      ]
    },
    {
      "TaskList": [
