{
  "OnInitSequece": [
    {
      "TaskList": []
    }
  ],
  "OnStartSequece": [
    {
      "TaskList": [
        {
          "$type": "RPG.GameCore.PropSetupUITrigger",
          "ButtonCallback": [
            {
              "$type": "RPG.GameCore.LockPlayerControl"
            },
            {
              "$type": "RPG.GameCore.ActiveVirtualCamera",
              "LevelAreaCameraKey": {
                "Custom": true,
                "Key": "IsoCamera"
              },
              "BlendConfig": {
                "ExportToJson": true,
                "BlendType": "EaseInOut",
                "BlendTime": 4
              }
            },
            {
              "$type": "RPG.GameCore.WaitSecond",
              "WaitTime": {
                "IsDynamic": false,
                "FixedValue": {
                  "Value": 1
                }
              }
            },
            {
              "$type": "RPG.GameCore.AdventureCameraToOrthographic",
              "OrethographicSize": {
                "IsDynamic": false,
                "FixedValue": {
                  "Value": 8
                }
              },
              "BlendIn": {
                "IsDynamic": false,
                "FixedValue": {
                  "Value": 3
                }
              },
              "BlendOut": {
                "IsDynamic": false,
                "FixedValue": {
                  "Value": 3
                }
              }
            },
            {
              "$type": "RPG.GameCore.WaitSecond",
              "WaitTime": {
                "IsDynamic": false,
                "FixedValue": {
                  "Value": 3.5
                }
              }
            },
            {
              "$type": "RPG.GameCore.SetIsometricRoadLinkerEnable",
              "TargetType": {
                "$type": "RPG.GameCore.TargetFetchAdvPropEx",
                "FetchType": "SinglePropByPropID",
                "SinglePropID": {
                  "GroupID": {
                    "IsDynamic": false,
                    "FixedValue": {
                      "Value": 6
                    }
                  },
                  "ID": {
                    "IsDynamic": false,
                    "FixedValue": {
                      "Value": 300002
                    }
                  }
                },
                "MultiPropKey": [
                  {
                    "Custom": true
                  },
                  {
                    "Custom": true
                  }
                ]
              },
              "Enable": true
            },
            {
              "$type": "RPG.GameCore.AdvStartIsometric"
            },
            {
              "$type": "RPG.GameCore.UnLockPlayerControl"
            }
          ],
          "OverrideTargetTypes": [],
          "TargetType": {
            "$type": "RPG.GameCore.TargetFetchAdvPropEx"
          }
        }
      ]
    }
  ],
  "ValueSource": {
    "Values": [
      {
        "$type": "RPG.GameCore.SharedString",
        "Key": "IsoCamera"
      }
    ]
  }
}