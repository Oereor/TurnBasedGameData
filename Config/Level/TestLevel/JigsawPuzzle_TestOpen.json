              "WaitTime": {
                "IsDynamic": false,
                "FixedValue": {
                  "Value": 1.5
                }
              }
            },
            {
              "$type": "RPG.GameCore.ActiveVirtualCamera",
              "LevelAreaCameraKey": {
                "Custom": true,
                "Key": "PuzzleCameraAnchor"
