                "$type": "RPG.GameCore.TargetFetchAdvPropEx"
              }
            },
            {
              "$type": "RPG.GameCore.ToastPage",
              "MessageOne": {
                "Hash": 2012001348524219443
              },
              "MessageTwo_DS": {
                "Custom": true,
                "Key": "CompleteHintString"
              },
              "CanInterrupt": true
            },
            {
              "$type": "RPG.GameCore.PropEnableCollider",
              "TargetType": {
                "$type": "RPG.GameCore.TargetFetchAdvPropEx"
              }
            },
            {
              "$type": "RPG.GameCore.PropSetVisibility",
