        "$type": "RPG.GameCore.SharedString",
        "Key": "PuzzleBoardPath"
      },
      {
        "$type": "RPG.GameCore.SharedString",
        "Key": "PuzzleCameraAnchor"
      },
      {
        "$type": "RPG.GameCore.SharedString",
        "Key": "JigsawResult_String"
      },
      {
        "$type": "RPG.GameCore.SharedString",
