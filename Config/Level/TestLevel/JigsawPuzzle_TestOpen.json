                    "Custom": true,
                    "Key": "PuzzleCameraAnchor"
                  }
                },
                {
                  "$type": "RPG.GameCore.PropEnableCollider",
                  "OPType": "TriggerOnly",
                  "TriggerSelect": "PropInteractionTrigger",
                  "TargetType": {
                    "$type": "RPG.GameCore.TargetFetchAdvPropEx"
                  }
                }
              ],
              "InteractAngleRange": 90,
              "OverrideTargetTypes": [],
              "TargetType": {
                "$type": "RPG.GameCore.TargetFetchAdvPropEx"
              }
            }
          ]
        }
      ]
    },
    {
      "TaskList": [
        {
