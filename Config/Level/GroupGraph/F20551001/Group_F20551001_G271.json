{
  "OnInitSequece": [],
  "OnStartSequece": [
    {
      "TaskList": [
        {
          "$type": "RPG.GameCore.LoopWaitServerPropStateChange"
        }
      ]
    },
    {
      "TaskList": [
        {
          "$type": "RPG.GameCore.SetCharacterVisible",
          "TargetType": {
            "$type": "RPG.GameCore.TargetFetchAdvNpcEx",
            "FetchType": "SingleNpcByOwnerGroupAndID",
            "SingleNpcKey": {
              "Custom": true,
              "Key": "TargetNPC"
            },
            "SingleNpcID": {
              "GroupNpcID": {
                "IsDynamic": false,
                "FixedValue": {
                  "Value": 400001
                }
              }
            },
            "NpcIDInOwnerGroup": {
              "IsDynamic": false,
              "FixedValue": {
                "Value": 400001
              }
            }
          }
        }
      ]
    },
    {
      "TaskList": [
        {
          "$type": "RPG.GameCore.WaitGroupEvent",
          "EventName": {
            "Value": "ShowNPC"
          },
          "OnEvent": [
            {
              "$type": "RPG.GameCore.SetCharacterVisible",
              "TargetType": {
                "$type": "RPG.GameCore.TargetFetchAdvNpcEx",
                "FetchType": "SingleNpcByOwnerGroupAndID",
                "SingleNpcKey": {
                  "Custom": true,
                  "Key": "TargetNPC"
                },
                "SingleNpcID": {
                  "GroupNpcID": {
                    "IsDynamic": false,
                    "FixedValue": {
                      "Value": 400001
                    }
                  }
                },
                "NpcIDInOwnerGroup": {
                  "IsDynamic": false,
                  "FixedValue": {
                    "Value": 400001
                  }
                }
              },
              "Visible": true
            }
          ]
        }
      ]
    },
    {
      "TaskList": [
        {
          "$type": "RPG.GameCore.WaitGroupEvent",
          "EventName": {
            "Value": "HideNPC"
          },
          "OnEvent": [
            {
              "$type": "RPG.GameCore.SetCharacterVisible",
              "TargetType": {
                "$type": "RPG.GameCore.TargetFetchAdvNpcEx",
                "FetchType": "SingleNpcByOwnerGroupAndID",
                "SingleNpcKey": {
                  "Custom": true,
                  "Key": "TargetNPC"
                },
                "SingleNpcID": {
                  "GroupNpcID": {
                    "IsDynamic": false,
                    "FixedValue": {
                      "Value": 400001
                    }
                  }
                },
                "NpcIDInOwnerGroup": {
                  "IsDynamic": false,
                  "FixedValue": {
                    "Value": 400001
                  }
                }
              }
            }
          ]
        }
      ]
    },
    {
      "TaskList": [
        {
          "$type": "RPG.GameCore.PredicateTaskList",
          "Predicate": {
            "$type": "RPG.GameCore.ByCompareFloorSavedValue",
            "DynamicName": {
              "Value": "FSV_StudioState"
            },
            "CompareType": "NotEqual",
            "CompareValue": 2
          },
          "SuccessTaskList": [
            {
              "$type": "RPG.GameCore.SetEntityVisible",
              "TargetType": {
                "$type": "RPG.GameCore.GroupFetchLocalTarget",
                "TargetType": "Prop",
                "Targets": [
                  300001
                ]
              },
              "MuteTriggerWhenInvisible": true,
              "SetAudio": true
            }
          ],
          "FailedTaskList": []
        }
      ]
    },
    {
      "TaskList": [
        {
          "$type": "RPG.GameCore.WaitFloorSavedValueChangeV2",
          "Name": {
            "Value": "FSV_StudioState"
          },
          "OnChange": [
            {
              "$type": "RPG.GameCore.PredicateTaskList",
              "Predicate": {
                "$type": "RPG.GameCore.ByComparePropState",
                "TargetType": {
                  "$type": "RPG.GameCore.GroupFetchLocalTarget",
                  "TargetType": "Prop",
                  "Targets": [
                    300001
                  ]
                },
                "State": "EventClose"
              },
              "SuccessTaskList": [
                {
                  "$type": "RPG.GameCore.PredicateTaskList",
                  "Predicate": {
                    "$type": "RPG.GameCore.ByCompareFloorSavedValue",
                    "DynamicName": {
                      "Value": "FSV_StudioState"
                    },
                    "CompareValue": 2
                  },
                  "SuccessTaskList": [
                    {
                      "$type": "RPG.GameCore.SetEntityVisible",
                      "TargetType": {
                        "$type": "RPG.GameCore.GroupFetchLocalTarget",
                        "TargetType": "Prop",
                        "Targets": [
                          300001
                        ]
                      },
                      "Visible": true,
                      "MuteTriggerWhenInvisible": true,
                      "SetAudio": true
                    }
                  ],
                  "FailedTaskList": [
                    {
                      "$type": "RPG.GameCore.SetEntityVisible",
                      "TargetType": {
                        "$type": "RPG.GameCore.GroupFetchLocalTarget",
                        "TargetType": "Prop",
                        "Targets": [
                          300001
                        ]
                      },
                      "MuteTriggerWhenInvisible": true,
                      "SetAudio": true
                    }
                  ]
                }
              ],
              "FailedTaskList": []
            }
          ]
        }
      ]
    }
  ],
  "ValueSource": {
    "Values": []
  },
  "Type": "Group",
  "EntityEventList": []
}