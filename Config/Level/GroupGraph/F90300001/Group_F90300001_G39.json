{
  "OnInitSequece": [
    {
      "TaskList": [
        {
          "$type": "RPG.GameCore.MemoryVisionPuzzleInit"
        }
      ]
    }
  ],
  "OnStartSequece": [
    {
      "TaskList": [
        {
          "$type": "RPG.GameCore.WaitGroupEvent",
          "EventName": {
            "Value": "OnMemoryVisionOpen"
          },
          "OnEvent": [
            {
              "$type": "RPG.GameCore.AdvCreateEntityAsync",
              "InstanceIDList": [],
              "AdvancedSpawnList": [
                {
                  "IsCreateAllEntityType": true
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "TaskList": [
        {
          "$type": "RPG.GameCore.WaitGroupEvent",
          "EventName": {
            "Value": "OnMemoryVisionClose"
          },
          "OnEvent": [
            {
              "$type": "RPG.GameCore.AdvDestroyEntityAsync",
              "NeedDisappear": true,
              "InstanceIDList": [],
              "AdvancedSpawnList": [
                {
                  "IsDestroyAllEntityType": true
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "TaskList": [
        {
          "$type": "RPG.GameCore.AdvDistrictSetupTrigger",
          "GroupID": {
            "IsDynamic": false,
            "FixedValue": {
              "Value": 38
            }
          },
          "DistrictID": {
            "IsDynamic": false,
            "FixedValue": {
              "Value": 1
            }
          },
          "OnExit": [
            {
              "$type": "RPG.GameCore.TriggerGroupEvent",
              "EventName": {
                "Value": "CloseMemoryVision"
              }
            }
          ]
        }
      ]
    }
  ],
  "Type": "Group"
}