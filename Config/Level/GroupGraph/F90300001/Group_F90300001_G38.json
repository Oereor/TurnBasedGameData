                },
                {
                  "InstanceID": 300002,
                  "SpawnEntityType": "Prop"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "TaskList": [
        {
          "$type": "RPG.GameCore.WaitGroupEvent",
