            "Value": "Puzzle2LG_OnMemoryVisionClose"
          },
          "OnEvent": [
            {
              "$type": "RPG.GameCore.AdvDestroyEntityAsync",
              "NeedDisappear": true,
              "InstanceIDList": [],
