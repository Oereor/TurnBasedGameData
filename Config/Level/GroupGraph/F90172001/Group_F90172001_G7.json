{
  "OnInitSequece": [
    {
      "TaskList": []
    }
  ],
  "OnStartSequece": [
    {
      "TaskList": []
    },
    {
      "TaskList": [
        {
          "$type": "RPG.GameCore.AdvSetupCustomTaskTrigger",
          "TargetType": {
            "$type": "RPG.GameCore.GroupFetchLocalTarget",
            "TargetType": "Prop",
            "Targets": [
              300001
            ]
          },
          "TriggerName": "StopTrigger",
          "OnEnter": [
            {
              "$type": "RPG.GameCore.PauseTimeRewindTarget",
              "Target": {
