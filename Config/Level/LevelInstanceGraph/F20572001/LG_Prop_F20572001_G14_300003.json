{
  "OnInitSequece": [
    {
      "TaskList": []
    }
  ],
  "OnStartSequece": [
    {
      "TaskList": [
        {
          "$type": "RPG.GameCore.AdvOnButtonPressed",
          "ButtonName": "Trigger",
          "OnPressedCallback": [
            {
              "$type": "RPG.GameCore.ActiveVirtualCamera",
              "LevelAreaCameraKey": {
                "Custom": true,
                "Key": "Camera01"
              },
              "TaskEnabled": false
            },
            {
              "$type": "RPG.GameCore.StartPropInteractMode",
              "TargetType": {
                "$type": "RPG.GameCore.TargetFetchAdvPropEx"
              },
              "Mode": "UsePose02"
            },
            {
              "$type": "RPG.GameCore.TriggerEntityEvent",
              "EventName": {
                "Value": "CallStageChange"
              }
            },
            {
              "$type": "RPG.GameCore.WaitSecond",
              "WaitTime": {
                "IsDynamic": false,
                "FixedValue": {
                  "Value": 2
                }
              }
            },
            {
              "$type": "RPG.GameCore.TriggerSound",
              "SoundName": {
                "Value": "Ev_sfx_planarcadia_crystalball_change"
              },
              "TargetType": {
                "$type": "RPG.GameCore.TargetFetchAdvPropEx"
              }
            },
            {
              "$type": "RPG.GameCore.WaitSecond",
              "WaitTime": {
                "IsDynamic": false,
                "FixedValue": {
                  "Value": 2
                }
              }
            },
            {
              "$type": "RPG.GameCore.EndPropInteract"
            },
            {
              "$type": "RPG.GameCore.ActiveVirtualCamera",
              "LevelAreaCameraKey": {
                "Custom": true,
                "Key": "Camera01"
              },
              "IsActive": false,
              "BlendConfig": {
                "ExportToJson": true,
                "BlendType": "EaseInOut",
                "CustomCurveData": {},
                "BlendTime": 1
              },
              "TaskEnabled": false
            }
          ]
        }
      ]
    },
    {
      "TaskList": [
        {
          "$type": "RPG.GameCore.AdvSetupButtonListTrigger",
          "TargetType": {
            "$type": "RPG.GameCore.TargetFetchAdvPropEx"
          },
          "TriggerName": "InteractTrigger",
          "ButtonsByName": [],
          "ButtonConfigs": [
            {
              "ID": "Trigger",
              "ButtonText": {
                "Value": "PropInteractTitle_1"
              }
            }
          ],
          "IsOverrideValidGuestConfig": true,
          "OverridedValidGuestConfig": {}
        }
      ]
    },
    {
      "TaskList": [
        {
          "$type": "RPG.GameCore.WaitEntityEvent",
          "EventName": {
            "Value": "CallStageChange"
          },
          "OnEvent": [
            {
              "$type": "RPG.GameCore.PredicateTaskList",
              "Predicate": {
                "$type": "RPG.GameCore.ByCompareGroupProperty",
                "DynamicName": {
                  "Value": "CrystalBall_State_GP"
                },
                "CompareValue": 1
              },
              "SuccessTaskList": [
                {
                  "$type": "RPG.GameCore.RequestSetServerGroupPropertyV2",
                  "DynamicName": {
                    "Value": "CrystalBall_State_GP"
                  }
                }
              ],
              "FailedTaskList": [
                {
                  "$type": "RPG.GameCore.RequestSetServerGroupPropertyV2",
                  "DynamicName": {
                    "Value": "CrystalBall_State_GP"
                  },
                  "Value": 1
                }
              ]
            }
          ]
        }
      ]
    }
  ],
  "ValueSource": {
    "Values": [
      {
        "$type": "RPG.GameCore.SharedString",
        "Key": "Camera01"
      }
    ]
  },
  "Type": "EntityInstance",
  "EntityEventList": [
    {
      "Name": "CallStageChange"
    }
  ]
}